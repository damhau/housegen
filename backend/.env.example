# Copy to .env and fill in what you use.

# anthropic | openai  (openai works with any OpenAI-compatible endpoint via OPENAI_BASE_URL)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Per-role model override (defaults: claude-opus-5 for anthropic, gpt-6-astra for openai)
# BUILDER_MODEL=
# CRITIC_MODEL=
# Reasoning effort per role (OpenAI: none…xhigh, Anthropic: low…max)
# BUILDER_EFFORT=xhigh
# CRITIC_EFFORT=medium
# Per-turn output cap (reasoning tokens count against it on OpenAI)
# LLM_MAX_TOKENS=96000

# Agent loop budgets
BUILDER_MAX_STEPS=60
CRITIC_MAX_ITERATIONS=2     # review rounds after the builder finishes (round 2 = one fix pass); 0 disables
CRITIC_SCORE_THRESHOLD=80
# RENDER_QUALITY=high          # in-loop renders (low | medium | high); high once renders take seconds (GPU service)

# Headless renderer: chrome | msedge | leave empty for the bundled chromium (playwright install chromium)
BROWSER_CHANNEL=chrome
# WebGL backend: swiftshader (software, any machine) | gl-egl | vulkan (an NVIDIA GPU in this container)
# RENDER_ANGLE=swiftshader
# Render on the GPU service (deploy/modal_render.py) instead of in this process. The service loads
# scenes from RENDER_BASE_URL: set it to this app's public URL.
# RENDER_SERVICE_URL=https://<workspace>--housegen-render-web.modal.run
# RENDER_SERVICE_TOKEN=
# RENDER_BASE_URL=https://housegen-dev.apps.dhconsulting.ch
# RENDER_SERVICE_FALLBACK=true   # unreachable service → render locally (false: the render fails)

ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
