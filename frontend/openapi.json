date Settings", "description": "Set the project's run settings (model, effort, critic rounds, step budget, in-loop\nrender quality). Unset fields keep the .env defaults. A running job is not affected: it\ntook its snapshot at start.", "operationId": "update_settings", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunSettings"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/projects/{project_id}/settings/effective": {"get": {"tags": ["projects"], "summary": "Effective Settings", "description": "What a run started now would use (the stored settings over the .env defaults, effort\nvalues mapped onto the provider).", "operationId": "effective_settings", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResolvedRunSettings"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/projects/{project_id}/estimate": {"get": {"tags": ["projects"], "summary": "Run Estimate", "description": "Rough duration and cost of the next run of `kind`, from this project's finished runs\nof that kind (or a typical profile before the first) and the price table.", "operationId": "run_estimate", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}, {"name": "kind", "in": "quer