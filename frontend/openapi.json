alth", "operationId": "health", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health"}}}}}}}}, "components": {"schemas": {"Body_create_project": {"properties": {"name": {"type": "string", "maxLength": 200, "minLength": 1, "title": "Name"}, "plan": {"type": "string", "contentMediaType": "application/octet-stream", "title": "Plan", "description": "PDF plan set"}, "photos": {"items": {"type": "string", "contentMediaType": "application/octet-stream"}, "type": "array", "title": "Photos", "description": "fa\u00e7ade photos"}, "sides": {"items": {"type": "string"}, "type": "array", "title": "Sides", "description": "side per photo, same order: north|south|east|west|other"}}, "type": "object", "required": ["name", "plan", "photos", "sides"], "title": "Body_create_project"}, "ChatMessageOut": {"properties": {"id": {"type": "string", "title": "Id"}, "role": {"type": "string", "title": "Role"}, "content": {"type": "string", "title": "Content"}, "job_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Job Id"}, "version_number": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Version Number"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}}, "type": "object", "required": ["id", "role", "content", "job_id", "version_number", "created_at"], "title": "ChatMessageOut"}, "Critique": {"properties": {"overall_score": {"type": "integer", "maximum": 100.0, "minimum": 0.0, "title": "Overall Score"}, "summary": {"type": "string", "title": "Summary"}, "done": {"type": "boolean", "title": "Done"}, "issues": {"items": {"$ref": "#/components/schemas/CritiqueIssue"}, "type": "array", "title": "Issues"}}, "type": "object", "required": ["overall_score", "summary", "done", "issues"], "title": "Critique"}, "CritiqueIssue": {"properties": {"view": {"type": "string", "title": "View"}, "severity": {"type": "string", "enum": ["major", "minor"], "title": "Severity"}, "description": {"type": "string", "title": "Description"}, "fix": {"type": "string", "title": "Fix"}}, "type": "object", "required": ["view", "severity", "description", "fix"], "title": "CritiqueIssue"}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "JobEventOut": {"properties": {"seq": {"type": "integer", "title": "Seq"}, "type": {"type": "string", "title": "Type"}, "payload": {"additionalProperties": true, "type": "object", "title": "Payload"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}}, "type": "object", "required": ["seq", "type", "payload", "created_at"], "title": "JobEventOut"}, "JobOut": {"properties": {"id": {"type": "string", "title": "Id"}, "project_id": {"type": "string", "title": "Project Id"}, "kind": {"type": "string", "title": "Kind"}, "status": {"type": "string", "title": "Status"}, "request_text": {"type": "string", "title": "Request Text"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Error"}, "result_version": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Result Version"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}, "finished_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Finished At"}}, "type": "object", "required": ["id", "project_id", "kind", "status", "request_text", "error", "result_version", "created_at", "finished_at"], "title": "JobOut"}, "ModifyRequest": {"properties": {"message": {"type": "string", "maxLength": 4000, "minLength": 1, "title": "Message"}}, "type": "object", "required": ["message"], "title": "ModifyRequest"}, "PhotoOut": {"properties": {"id": {"type": "string", "title": "Id"}, "side": {"type": "string", "enum": ["north", "south", "east", "west", "other"], "title": "Side"}, "original_name": {"type": "string", "title": "Original Name"}, "url": {"type": "string", "title": "Url"}}, "type": "object", "required": ["id", "side", "original_name", "url"], "title": "PhotoOut"}, "ProjectOut": {"properties": {"id": {"type": "string", "title": "Id"}, "name": {"type": "string", "title": "Name"}, "status": {"type": "string", "title": "Status"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}, "plan_pages": {"type": "integer", "title": "Plan Pages"}, "current_version": {"type": "integer", "title": "Current Version"}, "photos": {"items": {"$ref": "#/components/schemas/PhotoOut"}, "type": "array", "title": "Photos"}, "versions": {"items": {"$ref": "#/components/schemas/SceneVersionOut"}, "type": "array", "title": "Versions"}, "scene_url": {"type": "string", "title": "Scene Url"}, "plan_page_urls": {"items": {"type": "string"}, "type": "array", "title": "Plan Page Urls"}}, "type": "object", "required": ["id", "name", "status", "created_at", "plan_pages", "current_version", "photos", "versions", "scene_url", "plan_page_urls"], "title": "ProjectOut"}, "ProjectSummaryOut": {"properties": {"id": {"type": "string", "title": "Id"}, "name": {"type": "string", "title": "Name"}, "status": {"type": "string", "title": "Status"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}, "current_version": {"type": "integer", "title": "Current Version"}, "thumbnail_url": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Thumbnail Url"}}, "type": "object", "required": ["id", "name", "status", "created_at", "current_version", "thumbnail_url"], "title": "ProjectSummaryOut"}, "SceneFileOut": {"properties": {"path": {"type": "string", "title": "Path"}, "content": {"type": "string", "title": "Content"}}, "type": "object", "required": ["path", "content"], "title": "SceneFileOut"}, "SceneFilesOut": {"properties": {"version": {"type": "integer", "title": "Version"}, "files": {"items": {"$ref": "#/components/schemas/SceneFileOut"}, "type": "array", "title": "Files"}}, "type": "object", "required": ["version", "files"], "title": "SceneFilesOut"}, "SceneVersionOut": {"properties": {"id": {"type": "string", "title": "Id"}, "number": {"type": "integer", "title": "Number"}, "kind": {"type": "string", "title": "Kind"}, "label": {"type": "string", "title": "Label"}, "summary": {"type": "string", "title": "Summary"}, "critic_score": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Critic Score"}, "critique": {"anyOf": [{"$ref": "#/components/schemas/Critique"}, {"type": "null"}]}, "suggestions": {"items": {"type": "string"}, "type": "array", "title": "Suggestions", "default": []}, "questions": {"items": {"type": "string"}, "type": "array", "title": "Questions", "default": []}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}, "scene_url": {"type": "string", "title": "Scene Url"}, "render_urls": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Render Urls"}}, "type": "object", "required": ["id", "number", "kind", "label", "summary", "critic_score", "critique", "created_at", "scene_url", "render_urls"], "title": "SceneVersionOut"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
